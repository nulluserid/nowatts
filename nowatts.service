[Unit]
Description=nowatts — USB-C power status daemon (nowatts)
Documentation=https://github.com/nulluserid/nowatts/blob/main/CONTRACT.md
# No network dependency: nowatts only reads local sysfs.

[Service]
ExecStart=%h/.local/bin/nowatts
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
